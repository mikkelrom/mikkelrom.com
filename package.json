{
  "name": "hylia",
  "version": "0.5.1",
  "description": "A simple Eleventy starter kit to help you have a blog of your own",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "concurrently": "^7.0.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^28.1.0",
    "json-to-scss": "^1.6.2",
    "sass": "^1.103.1",
    "semver": "^7.5.2",
    "slugify": "^1.6.5",
    "speedlify-score": "^2.0.2",
    "yargs-parser": "^21.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "bl": "^5.0.0",
    "cross-env": "^7.0.3",
    "prettier": "^2.5.1"
  },
  "scripts": {
    "sass:tokens": "npx json-to-scss src/_data/tokens.json src/scss/_tokens.scss",
    "sass:process": "npm run sass:tokens && sass src/scss/global.scss src/_includes/assets/css/global.css --style=compressed",
    "start": "concurrently \"npm run sass:process -- --watch\" \"npm run serve\"",
    "serve": "cross-env ELEVENTY_ENV=development npx eleventy --serve",
    "mermaid": "mmdc -i src/images/caching-layers.mmd -o src/images/caching-layers.svg",
    "production": "npm run mermaid && npm run sass:process && npx eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hankchizljaw/hylia.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hankchizljaw/hylia/issues"
  },
  "homepage": "https://github.com/hankchizljaw/hylia#readme",
  "overrides": {
    "lodash-es": "^4.18.0"
  }
}
