{
  "name": "mikkelrom.com",
  "version": "1.0.0",
  "private": true,
  "description": "Personal blog about web tech, architecture, performance and design systems. Built with Eleventy.",
  "author": "Mikkel Rom Engholm",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikkelrom/mikkelrom.com.git"
  },
  "homepage": "https://mikkelrom.com",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^28.1.0",
    "json-to-scss": "^1.6.2",
    "markdown-it": "^14.3.0",
    "sass": "^1.103.1",
    "slugify": "^1.6.9",
    "speedlify-score": "^2.0.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "sass:tokens": "json-to-scss src/_data/tokens.json src/scss/_tokens.scss",
    "sass:process": "npm run sass:tokens && sass src/scss/global.scss src/_includes/assets/css/global.css --style=compressed",
    "mermaid": "mmdc -i src/images/caching-layers.mmd -o src/images/caching-layers.svg",
    "serve": "eleventy --serve",
    "start": "concurrently \"npm run sass:process -- --watch\" \"npm run serve\"",
    "production": "npm run clean && npm run sass:process && eleventy"
  },
  "overrides": {
    "lodash-es": "^4.18.0"
  }
}
